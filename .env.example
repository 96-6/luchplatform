# Local development. Never commit .env or real credentials.
APP_ENV=development
APP_URL=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=3000
WEB_PORT=5173
# File-backed PostgreSQL for a single local API process; relative to repository root.
DATABASE_URL=pglite:./data/luch
# For a separate PostgreSQL server: postgresql://user:password@host:5432/luch
DATABASE_SSL=false
ENABLE_DEV_TOOLS=true
SERVE_WEB=false
LOG_LEVEL=info
# Server-only integration settings; adapters are implemented in later tasks.
AI_API_URL=
AI_API_KEY=
SPEECH_API_URL=
SPEECH_API_KEY=
VIDEO_SERVICE_URL=
VIDEO_API_KEY=
