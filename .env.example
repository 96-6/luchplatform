# Local development. Never commit .env or real credentials.
APP_ENV=development
APP_URL=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=3000
WEB_PORT=5173
# File-backed PostgreSQL for a single local API process; relative to repository root.
DATABASE_URL=pglite:./data/luch
# For a separate PostgreSQL server: postgresql://user:password@host:5432/luch
DATABASE_SSL=false
ENABLE_DEV_TOOLS=true
LOCAL_DEBUG_LOGIN=false
LOCAL_DEBUG_ADMIN_ALIAS=
SERVE_WEB=false
LOG_LEVEL=info
AUTH_ENCRYPTION_KEY=
MAIL_MODE=local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ЛУЧ <no-reply@localhost>
TRUST_PROXY_CIDRS=
IP_INTEL_URL=
IP_INTEL_KEY=
NETWORK_PROBE_URLS=
NETWORK_STUN_URLS=
# Optional server-only keys; superadmin can configure these providers in the application.
OPENAI_API_KEY=
NEUROAPI_API_KEY=
HEYGEN_API_KEY=
# Shared server-side fallback for ElevenLabs Scribe STT and TTS. Models, rates, budgets and
# feature switches are configured in the superadmin provider settings; disabled by default.
ELEVENLABS_API_KEY=
# Reserved settings; not used by the ElevenLabs adapters above.
AI_API_URL=
AI_API_KEY=
SPEECH_API_URL=
SPEECH_API_KEY=
VIDEO_SERVICE_URL=
VIDEO_API_KEY=

# Private self-hosted LiveKit endpoints (server only). Use setup.mjs --video.
LIVEKIT_URL=
LIVEKIT_WS_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_NODE_IP=127.0.0.1

# Private persistent directory for meeting attachments; back up together with PostgreSQL.
MEETING_FILE_DIRECTORY=data/meeting-files
