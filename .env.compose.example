# Copy to .env.compose, set a local/test password, then use --env-file .env.compose.
POSTGRES_PASSWORD=replace-with-a-local-test-password
APP_ENV=development
APP_URL=http://localhost:3000
APP_PORT=3000
ENABLE_DEV_TOOLS=true
LOG_LEVEL=info
# For hosting: APP_ENV=production, APP_URL=https://your-domain, ENABLE_DEV_TOOLS=false.
AI_API_URL=
AI_API_KEY=
SPEECH_API_URL=
SPEECH_API_KEY=
VIDEO_SERVICE_URL=
VIDEO_API_KEY=
